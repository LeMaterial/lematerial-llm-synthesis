    "\n",
    "from dotenv import load_dotenv\n",
    "env_path = Path(\"../../.env\")\n",
    "load_dotenv(env_path, override=True)\n",
    "\n",
    "warnings.filterwarnings(\"ignore\", category=UserWarning, module=\"pydantic\")\n",
