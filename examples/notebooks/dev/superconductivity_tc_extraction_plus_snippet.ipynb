    "\n",
    "    print(f\"\\n{'=' * 70}\")\n",
    "    print(\"RECONCILIATION ACTIONS (raw LLM output)\")\n",
    "    print(\"=\" * 70)\n",
    "    print(recon_raw)\n",
    "\n",
    "    # ── Parse reconciliation actions ──\n",
    "    n_matched = 0\n",
    "    n_filled_text = 0\n",
    "    n_filled_vlm = 0\n",
    "    n_added = 0\n",
    "    n_discarded = 0\n",
    "\n",
    "    for line in recon_raw.strip().split(\"\\n\"):\n",
    "        line = line.strip()\n",
    "        if not line or \"|\" not in line:\n",
    "            continue\n",
    "        parts = [p.strip() for p in line.split(\"|\")]\n",
    "        if len(parts) < 4:\n",
