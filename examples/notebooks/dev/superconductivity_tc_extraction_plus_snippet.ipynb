    "inset_type: <\"zoomed_rt\" | \"tc_summary\" | \"other\" | \"none\">\n",
    "inset_description: <brief description or \"N/A\">\n",
    "inset_axes: <tick marks if present, otherwise \"N/A\">\n",
    "inset_tc_values: <series: value K, ... or \"N/A\">\n",
