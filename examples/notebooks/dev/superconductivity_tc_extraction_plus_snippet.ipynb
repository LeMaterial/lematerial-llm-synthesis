    "    )\n",
    "    recon_extractor = DspyTextExtractor(signature=recon_sig, lm=recon_lm)\n",
    "\n",
    "    try:\n",
    "        recon_raw = recon_extractor.forward(input=\"Perform reconciliation as described above.\")\n",
    "    except Exception as e:\n",
